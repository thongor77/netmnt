#: crates/netmnt/src/creds.rs:66
#, rust-format
msgid "Username for {url}"
msgstr "Nom d’utilisateur pour {url}"

#: crates/netmnt/src/creds.rs:81
#, rust-format
msgid "Password for {username} at {url}"
msgstr "Mot de passe de {username} pour {url}"

#: crates/netmnt/src/creds.rs:95
msgid "Remember in KWallet?"
msgstr "Mémoriser dans KWallet ?"

#: crates/netmnt/src/creds.rs:141
msgid "kwallet-query could not save the credentials"
msgstr "kwallet-query n’a pas pu enregistrer les identifiants"

#: crates/netmnt/src/main.rs:32 crates/netmntd/src/exec.rs:53
#, rust-format
msgid "Unsupported URL scheme (expected smb:// or nfs://): {url}"
msgstr "Schéma d’URL non pris en charge (smb:// ou nfs:// attendu) : {url}"

#: crates/netmnt/src/main.rs:64
msgid "Mount network shares from a single click"
msgstr "Monter des partages réseau en un clic"

#: crates/netmnt/src/main.rs:67
msgid "Mount a share for the current session"
msgstr "Monter un partage pour la session en cours"

#: crates/netmnt/src/main.rs:69
msgid "Source URL, for example smb://nas.local/share"
msgstr "URL source, par exemple smb://nas.local/partage"

#: crates/netmnt/src/main.rs:73
msgid "Keep the mount across reboots using a systemd mount unit"
msgstr ""
"Conserver le montage après redémarrage avec une unité de montage systemd"

#: crates/netmnt/src/main.rs:77
msgid "Use an explicit username and prompt for its password"
msgstr "Utiliser un nom d’utilisateur précis et demander son mot de passe"

#: crates/netmnt/src/main.rs:81
msgid "Ask for credentials or reuse credentials stored in KWallet"
msgstr "Demander des identifiants ou réutiliser ceux enregistrés dans KWallet"

#: crates/netmnt/src/main.rs:87
msgid "Unmount a share by its mount point or URL"
msgstr "Démonter un partage à partir de son point de montage ou de son URL"

#: crates/netmnt/src/main.rs:90
msgid ""
"Absolute path of the mount point, or the smb:// or nfs:// URL of the share"
msgstr ""
"Chemin absolu du point de montage, ou URL smb:// ou nfs:// du partage"

#: crates/netmnt/src/main.rs:169
#, rust-format
