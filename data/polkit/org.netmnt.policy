<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>netmnt</vendor>

  <action id="org.netmnt.mount">
    <description>Mount a network share</description>
    <description xml:lang="fr">Monter un partage réseau</description>
    <description xml:lang="uk">Змонтувати мережевий ресурс</description>
    <message>Authentication is required to mount a network share</message>
    <message xml:lang="fr">Une authentification est requise pour monter un partage réseau</message>
    <message xml:lang="uk">Для монтування мережевого ресурсу потрібна автентифікація</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- the active local user mounts session shares without a prompt;
           persistent mounts (org.netmnt.mount-persistent) still need admin auth -->
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.netmnt.mount-persistent">
    <description>Create a persistent network mount</description>
    <description xml:lang="fr">Créer un montage réseau persistant</description>
    <description xml:lang="uk">Створити постійне мережеве монтування</description>
    <message>Authentication is required to create a persistent network mount</message>
    <message xml:lang="fr">Une authentification est requise pour créer un montage réseau persistant</message>
    <message xml:lang="uk">Для створення постійного мережевого монтування потрібна автентифікація</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.netmnt.unmount">
    <description>Unmount a network share</description>
    <description xml:lang="fr">Démonter un partage réseau</description>
    <description xml:lang="uk">Демонтувати мережевий ресурс</description>
    <message>Authentication is required to unmount a network share</message>
    <message xml:lang="fr">Une authentification est requise pour démonter un partage réseau</message>
    <message xml:lang="uk">Для демонтування мережевого ресурсу потрібна автентифікація</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
